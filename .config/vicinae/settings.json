{
   "$schema": "https://vicinae.com/schemas/config.json",
   "close_on_focus_loss": false,
   "pop_to_root_on_close": true,
   "favicon_service": "google",
   "search_files_in_root": false,
   "tray": {
      "enabled": false
   },
   "font": {
      "normal": {
         "family": "JetBrains Mono Medium",
         "size": 13
      }
   },
   "theme": {
      "dark": {
         "name": "catppuccin-mocha",
         "icon_theme": "Breeze Dark"
      }
   },
   "launcher_window": {
      "opacity": 0.95,
      "client_side_decorations": {
         "border_width": 2
      },
      "compact_mode": {
         "enabled": false
      },
      "floating_status_bar": true
   },
   "favorites": [],
   "providers": {
      "@luleyleo/wiktionary": {
         "preferences": {
            "resultLanguages": "",
            "source": "empty"
         }
      },
      "applications": {
         "preferences": {
            "paths": [
               "/home/rishabh/.local/share/applications",
               "/usr/share/applications"
            ]
         }
      },
      "clipboard": {
         "preferences": {
            "monitoring": true
         }
      },
      "files": {
         "enabled": false,
         "preferences": {
            "autoIndexing": false,
            "excludedIndexingPaths": [],
            "indexingPaths": [
               "/home/rishabh"
            ]
         }
      }
   }
}